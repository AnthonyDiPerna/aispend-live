{
  "name": "aispend-live",
  "version": "0.7.0",
  "private": false,
  "description": "Local multi-subscription AI usage dashboard, optimizer, and Guard for Claude, Codex, and Antigravity.",
  "main": "tools/ai-spend-dashboard-server.js",
  "scripts": {
    "check": "node tools/checkin-cli.js",
    "check:live": "node tools/checkin-cli.js --live",
    "check:watch": "node tools/checkin-cli.js --watch",
    "guard": "node tools/usage-guard-server.js",
    "guard:demo": "node tools/usage-guard-server.js --demo",
    "test:optimizer": "node tools/subscription-optimizer-test.js",
    "test:guard": "node tools/usage-guard-test.js && node tools/usage-collectors-test.js && node tools/guard-advisor-test.js && node tools/guard-recovery-test.js && node tools/guard-continuity-test.js && node tools/guard-rejection-test.js && node tools/guard-watchdog-test.js && node tools/subscription-optimizer-test.js",
    "dashboard": "node tools/ai-spend-dashboard-server.js",
    "summary": "node tools/ai-spend-dashboard-server.js --summary",
    "demo:export": "node tools/export-public-demo.js",
    "history:export": "node tools/export-history.js",
    "test:public-demo": "node tools/public-demo-test.js",
    "test:history": "node tools/export-history-test.js",
    "test": "node tools/ai-spend-dashboard-test.js && node tools/export-history-test.js",
    "test:pi": "node tools/usage-guard-pi-test.js",
    "guard:export": "node tools/export-guard-demo.js",
    "guard:snapshot": "node tools/export-guard-snapshot.js",
    "guard:watch": "node tools/guard-watchdog.js",
    "guard:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File integrations/pi/Restart-Controller.ps1",
    "site:preview": "node tools/preview-public.js"
  },
  "keywords": [
    "ai",
    "spend",
    "claude",
    "codex",
    "antigravity",
    "agy",
    "optimizer",
    "tokens",
    "dashboard"
  ],
  "license": "MIT"
}
